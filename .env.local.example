# Optional: enables AI-powered syllabus parsing (much more accurate).
# Copy this file to .env.local and paste a free Google Gemini API key from
# https://aistudio.google.com/apikey (free tier, no credit card needed).
# Without a key the app still works using rule-based date detection.
AI_API_KEY=

# The parser works with any OpenAI-compatible provider. These defaults
# target Gemini's free tier; uncomment and change them to use another
# provider (Groq, OpenRouter, OpenAI...) - see the README for values.
# AI_MODEL may be a comma-separated list; models are tried in order, which
# covers the free tier answering "high demand" (503) for the newest model.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
